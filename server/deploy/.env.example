# === Required ===
# 32+ bytes base64; lock cookies to this key. Generate:
#   openssl rand -base64 48
COOKIE_SECRET=

# Public base URL (https://your-host) used for OAuth callbacks and magic-link
BASE_URL=https://your-host.example.com

# === Server ===
ADDR=127.0.0.1:8787
DB_PATH=/home/rmv/ild-server/data/ild.db
SESSION_TTL_HOURS=720
SECURE_COOKIE=true

# === Google OAuth (optional — leave empty to disable) ===
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Email magic-link ===
# MAILER_MODE=stdout — print to logs (no SMTP needed; for tests).
# MAILER_MODE=smtp — actually send.
MAILER_MODE=stdout
MAGIC_LINK_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ild <no-reply@example.com>"

# === CORS — origin GH Pages фронтенда (через запятую) ===
ALLOWED_ORIGINS=https://rmv0x11.github.io
