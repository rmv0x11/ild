# All variables must use the ILD_ prefix — config.Load() reads only ILD_*.

# === Required ===
# 32+ bytes base64; locks cookies to this key. Generate:
#   openssl rand -base64 48
ILD_COOKIE_SECRET=

# Public base URL (https://your-host) used for OAuth callbacks and magic-link
ILD_BASE_URL=https://your-host.example.com

# === Server ===
ILD_ADDR=127.0.0.1:8787
ILD_DB_PATH=/home/rmv/ild-server/data/ild.db
ILD_SESSION_TTL_HOURS=720
ILD_SECURE_COOKIE=true

# === Google OAuth (optional — leave empty to disable) ===
# Create at https://console.cloud.google.com/apis/credentials
ILD_GOOGLE_CLIENT_ID=
ILD_GOOGLE_CLIENT_SECRET=

# === Email magic-link ===
# ILD_MAILER_MODE=stdout — print to logs (no SMTP needed; for tests).
# ILD_MAILER_MODE=smtp — actually send.
ILD_MAILER_MODE=stdout
ILD_MAGIC_LINK_TTL_MINUTES=15
ILD_SMTP_HOST=
ILD_SMTP_PORT=587
ILD_SMTP_USER=
ILD_SMTP_PASS=
ILD_SMTP_FROM="ild <no-reply@example.com>"

# === CORS — origin GH Pages фронтенда (через запятую) ===
ILD_ALLOWED_ORIGINS=https://rmv0x11.github.io
